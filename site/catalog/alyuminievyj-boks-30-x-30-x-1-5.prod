                                                <script>
                    function initSwiperProductsSlider() {
                        const swiperProductsSlider = new Swiper('.products-custom__slider-js', {
                            slidesPerView: 3,
                            loop: false,
                            spaceBetween: 3,
                            navigation: {
                                nextEl: '.products-custom__slider-next',
                                prevEl: '.products-custom__slider-prev',
                            },
                            breakpoints: {
                                320: {
                                    slidesPerView: 'auto',
                                },
                                1025: {
                                    slidesPerView: 3,
                                }
                            }
                        });
                    }
                    function loadSvg(){
                        $('[data-svg]').not('loaded').each(function () {
                            var $i = $(this).addClass('loaded');

                            $.get($i.data('svg'), function (data) {
                                var $svg = $(data).find('svg');

                                $svg.attr('class', $i.attr('class'));
                                $i.replaceWith($svg);
                            }, 'xml');
                        });
                    }
