DirectoryIndex index.html
AddType text/html .prod .tag
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
# Product and content files are edited directly from the admin panel. Force
# browsers and hosting proxies to revalidate them so saved changes are visible
# immediately on desktop and mobile.
<FilesMatch "\.(?:html|prod|tag)$">
Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
Header always set Pragma "no-cache"
Header always set Expires "0"
</FilesMatch>
</IfModule>

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Publish current catalog URLs on the production domain.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Imported CSS/JS bundles are permanent design assets, not disposable cache.
# Keep old URLs working even when hosting cache cleanup removes their files.
RewriteRule ^bitrix/cache/((?:css|js)/.+\.(?:css|js))$ assets/design/$1 [L]

# Static catalog pages use Bitrix-style pagination query parameters. Route
# those requests through the local archive dispatcher so page 2+ serves its
# own captured product list instead of falling back to page 1.
RewriteCond %{REQUEST_URI} !^/pagination\.php$ [NC]
RewriteCond %{QUERY_STRING} (^|&)PAGEN_[0-9]+=[0-9]+(&|$) [NC]
RewriteRule ^ pagination.php [L]

# Keep customer data independent of deployed static design templates.
RewriteRule ^admin/ - [L]
RewriteRule ^(.+\.(?:html|prod|tag))$ content.php?alym_file=$1 [QSA,L]
